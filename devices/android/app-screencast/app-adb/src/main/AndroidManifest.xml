<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="PC Dock ADB"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Точка входа: запрос захвата, запуск сервиса. Без иконки в лаунчере:
             старт через `adb shell am start -n com.device.media.adb/.AdbActivity`. -->
        <activity
            android:name=".AdbActivity"
            android:exported="true" />

        <service
            android:name=".AdbService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <service
            android:name=".DockAccessService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dock_accessibility" />
        </service>

    </application>
</manifest>
